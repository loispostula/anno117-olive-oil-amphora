<ModOps>
  <!-- Olive Press (4831): olives + amphorae -> olive oil amphora. -->
  <ModOp GUID="4831" Add="FactoryBase/FactoryInputs"
         Condition="!FactoryBase/FactoryInputs/Item[Product='31700']">
    <Item>
      <Product>31700</Product>
      <Amount>1</Amount>
      <StorageAmount>3</StorageAmount>
    </Item>
  </ModOp>

  <!-- Production chain views: Latium (31806) and Albion (55972) olive oil. -->
  <ModOp GUID="31806" Add="ProductionChain/Tier1"
         Condition="!ProductionChain/Tier1/Item[Building='3199']">
    <Item>
      <Building>3199</Building>
      <Tier2>
        <Item><Building>2970</Building></Item>
        <Item><Building>31752</Building></Item>
      </Tier2>
    </Item>
  </ModOp>
  <ModOp GUID="55972" Add="ProductionChain/Tier1"
         Condition="!ProductionChain/Tier1/Item[Building='55962']">
    <Item>
      <Building>55962</Building>
      <Tier2>
        <Item><Building>5848</Building></Item>
        <Item><Building>31761</Building></Item>
      </Tier2>
    </Item>
  </ModOp>

  <!--
    Olive oil (2149) becomes "Olive Oil Amphora". Same GUID on purpose: Roman / Albion household
    needs, Unguentarium perfume and the oil lamp workshop keep consuming it unchanged.
  -->
  <ModOp GUID="2149" Merge="">
    <Text>
      <OasisId>2001004149</OasisId>
    </Text>
  </ModOp>
  <ModOp GUID="2149" Merge="Standard">
    <IconFilename>data/olive-oil-amphora/ui/icon_olive_oil_amphora.png</IconFilename>
  </ModOp>
  <ModOp GUID="2778" Merge="Standard">
    <IconFilename>data/olive-oil-amphora/ui/icon_olive_oil_amphora.png</IconFilename>
  </ModOp>
  <ModOp GUID="55961" Merge="Standard">
    <IconFilename>data/olive-oil-amphora/ui/icon_olive_oil_amphora.png</IconFilename>
  </ModOp>
  <!-- Production chain views and the build menu show building / chain icons, not product icons. -->
  <ModOp GUID="4831" Merge="Standard">
    <IconFilename>data/olive-oil-amphora/ui/icon_olive_oil_amphora.png</IconFilename>
  </ModOp>
  <ModOp GUID="31806" Merge="Standard">
    <IconFilename>data/olive-oil-amphora/ui/icon_olive_oil_amphora.png</IconFilename>
  </ModOp>
  <ModOp GUID="55972" Merge="Standard">
    <IconFilename>data/olive-oil-amphora/ui/icon_olive_oil_amphora.png</IconFilename>
  </ModOp>

  <!--
    Unguentarium perfume chain views: show the Amphorae Workshop under the Olive Press.
    1556002102 (Latium) exists since 1.6, 1556002103 (Albion) since 1.7. The recipe is not touched.
  -->
  <Group Condition="@1556002102">
    <ModOp GUID="1556002102" Add="ProductionChain/Tier1/Item[Building='4831']"
           Condition="!ProductionChain/Tier1/Item[Building='4831']/Tier2">
      <Tier2 />
    </ModOp>
    <ModOp GUID="1556002102" Add="ProductionChain/Tier1/Item[Building='4831']/Tier2"
           Condition="!ProductionChain/Tier1/Item[Building='4831']/Tier2/Item[Building='3199']">
      <Item><Building>3199</Building></Item>
    </ModOp>
  </Group>
  <Group Condition="@1556002103">
    <ModOp GUID="1556002103" Add="ProductionChain/Tier1/Item[Building='4831']"
           Condition="!ProductionChain/Tier1/Item[Building='4831']/Tier2">
      <Tier2 />
    </ModOp>
    <ModOp GUID="1556002103" Add="ProductionChain/Tier1/Item[Building='4831']/Tier2"
           Condition="!ProductionChain/Tier1/Item[Building='4831']/Tier2/Item[Building='3199']">
      <Item><Building>3199</Building></Item>
    </ModOp>
  </Group>
</ModOps>
